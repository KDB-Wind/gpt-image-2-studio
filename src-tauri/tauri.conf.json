{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat To Image",
  "version": "0.1.6",
  "identifier": "dev.local.chat-to-image",
  "build": {
    "beforeDevCommand": "npm run dev -- --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chat To Image",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}

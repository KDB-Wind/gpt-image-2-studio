PLATFORM_PROVIDER_ID=ruoli
PLATFORM_BASE_URL=https://ruoli.dev/v1
PLATFORM_IMAGE_MODEL=gpt-image-2
PLATFORM_API_KEY=replace-with-your-hosted-api-key
PLATFORM_API_KEY_MAX_IN_FLIGHT=1
PLATFORM_ADMIN_TOKEN=local-admin-token
PLATFORM_OUTPUT_DIR=/app/platform-outputs
GENERATION_JOB_TIMEOUT_MS=240000
PROVIDER_CIRCUIT_COOLDOWN_MS=300000

# Local development can omit SMTP. The API console prints verification codes.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notice@example.com
# SMTP_PASS=change-me
# SMTP_FROM=Chat To Image <notice@example.com>

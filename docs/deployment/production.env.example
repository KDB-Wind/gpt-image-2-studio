NODE_ENV=production
PORT=3000
PUBLIC_WEB_ORIGIN=https://your-domain.com

DATABASE_URL=postgres://chat_to_image:change-me@127.0.0.1:5432/chat_to_image
REDIS_URL=redis://127.0.0.1:6379

PLATFORM_PROVIDER_ID=ruoli
PLATFORM_BASE_URL=https://ruoli.dev/v1
PLATFORM_IMAGE_MODEL=gpt-image-2
PLATFORM_API_KEYS=sk-key-1,sk-key-2
PLATFORM_API_KEY_MAX_IN_FLIGHT=1
PLATFORM_ADMIN_TOKEN=change-me-long-random-token
PLATFORM_OUTPUT_DIR=/opt/chat-to-image/shared/images

GENERATION_JOB_TIMEOUT_MS=240000
GENERATION_WORKER_CONCURRENCY=2
PROVIDER_CIRCUIT_COOLDOWN_MS=300000

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notice@example.com
SMTP_PASS=change-me
SMTP_FROM=Chat To Image <notice@example.com>

AUTH_CODE_RATE_LIMIT_WINDOW_MS=3600000
AUTH_CODE_MAX_PER_EMAIL=5
AUTH_CODE_MAX_PER_IP=20
